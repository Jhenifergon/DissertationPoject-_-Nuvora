rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Loose on purpose: only the fields that matter for correctness are
    // constrained (title's type, done's type, priority's enum). Anything
    // else (module, due, currentStep's shape, etc.) is left unvalidated —
    // per the brief, the priority is ownership first, reasonable value
    // validation second, and rules that stay maintainable third. A
    // partial updateDoc() still evaluates against the *resulting* merged
    // document here, not just the changed fields, so this also covers
    // task edits correctly.
    function isValidTask() {
      let data = request.resource.data;
      return data.title is string
        && data.done is bool
        && (!('priority' in data) || data.priority in ['low', 'normal', 'high']);
    }

    // A check-in's risk is either absent/null (an incomplete check-in —
    // see lib/store.js's saveCheckin and the Phase 2 "don't invent a
    // neutral score" rule) or a valid scored result.
    function isValidCheckin() {
      let data = request.resource.data;
      return !('risk' in data) || data.risk == null || (
        data.risk.score is number && data.risk.score >= 0 && data.risk.score <= 100
        && data.risk.band in ['Low', 'Moderate', 'Higher']
      );
    }

    match /users/{userId} {
      // Settings/stats on the user document itself: ownership only — no
      // schema imposed here, since these are simple preference/count
      // fields with no security-relevant range to enforce.
      allow read, write: if isOwner(userId);

      match /tasks/{taskId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTask();
      }

      match /checkins/{checkinId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCheckin();
      }

      match /reflections/{reflectionId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
